# Ngrok configuration for Telegram webhook tunnel
# Get your authtoken at: https://dashboard.ngrok.com/get-started/your-authtoken

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Synology NAS (Reverse Proxy + сертификаты поддоменов тенантов)
NAS_DSM_URL=http://192.168.8.3:5000
NAS_DSM_USER=jack
NAS_DSM_PASSWORD=your_nas_password
NAS_BACKEND_HOST=192.168.8.145
NAS_BACKEND_PORT=80
# Базовый домен поддоменов организаций (<slug>.welans.cc)
NAS_BASE_DOMAIN=welans.cc
# Email для регистрации Let's Encrypt на NAS

# Обязательные секреты Docker Compose (задаются только в игнорируемом .env)
POSTGRES_PASSWORD=replace_with_strong_database_password
JWT_SECRET=replace_with_random_secret_at_least_32_characters
VAPID_PUBLIC_KEY=replace_with_vapid_public_key
VAPID_PRIVATE_KEY=replace_with_vapid_private_key
VK_CLIENT_SECRET=replace_with_vk_client_secret
BEGET_PASSWORD=replace_with_beget_password
TOCHKA_CLIENT_SECRET=replace_with_tochka_client_secret
